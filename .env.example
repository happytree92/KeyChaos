# ─── KeyChaos — Environment Variables ───────────────────────────────────────
# Copy this to .env (or set in docker-compose.yml) before running.
# .env is gitignored — never commit real credentials.
#
# KeyChaos has no built-in authentication. Put it behind a reverse proxy
# (Pangolin / Traefik / nginx) that enforces auth, and don't expose port 3000
# directly to the internet.

# Server
PORT=3000

# Set to false if clients connect directly (no reverse proxy) — otherwise
# clients can spoof X-Forwarded-For and dodge per-IP rate limits.
TRUST_PROXY=true

# ─── SmartPass pepper ────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
SMARTPASS_PEPPER=

# ─── PwdPush ─────────────────────────────────────────────────────────────────
# Default: pwpush.com — change for self-hosted instances
PWD_PUSH_URL=https://pwpush.com
# API token from your PwdPush account (server-side only, never exposed to browser)
PWD_PUSH_TOKEN=your_token_here
# 'v2' for pwpush.com and Self-Hosted Pro | 'v1' for open-source self-hosted
PWD_PUSH_VERSION=v2

# ─── Rate limits ─────────────────────────────────────────────────────────────
RATE_LIMIT_PER_MIN=20
RATE_LIMIT_PER_HOUR=200
